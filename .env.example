# ── Frontend (exposed to the browser, prefix VITE_) ──
# Supabase project used for auth, profiles, credits and module data.
# Leave empty to run the app in demo mode with mock data only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Serverless functions (Vercel in production, Vite middleware in dev) ──
# Google Gemini key used by /api/chat
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Prediction engine proxied by /api/predict
RAILWAY_API_URL=https://your-prediction-backend.example.com
RAILWAY_API_KEY=your-prediction-api-key
